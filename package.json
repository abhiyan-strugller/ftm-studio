{
  "name": "ftm-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Content system for the Follow the Money Facebook page",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "samples": "tsx --tsconfig scripts/tsconfig.json scripts/render-samples.ts",
    "fonts": "tsx scripts/fetch-fonts.ts",
