# ---------------------------------------------------------------------------
# FTM Studio environment. Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project Settings -> Data API  (URL + anon key), Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Auth gate ------------------------------------------------------------
# Only this email may sign in to /planner.
ALLOWED_EMAIL=you@example.com

# --- Anthropic (draft generation) ----------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-haiku-4-5.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Telegram bot ---------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AA...
# Your numeric chat id (from @userinfobot). Every other chat is ignored.
TELEGRAM_CHAT_ID=123456789
# You invent this. Passed to setWebhook and verified on every update.
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string

# --- Facebook page --------------------------------------------------------
# Written for you by `npm run fb:token`.
FB_PAGE_ID=
FB_PAGE_TOKEN=
# Graph API version used for publishing.
FB_GRAPH_VERSION=v23.0

# --- Internal secrets -----------------------------------------------------
# Guards /api/render. Generate a long random string.
RENDER_SECRET=generate-a-long-random-string
# Guards /api/cron/publish-due. n8n sends it as the x-cron-secret header.
CRON_SECRET=generate-a-long-random-string

# --- Safety switch --------------------------------------------------------
# true  = log the Facebook request instead of sending it (safe for testing)
# false = publish for real
DRY_RUN=true

# --- Deployment -----------------------------------------------------------
# Public base URL of this app. Used to build absolute render URLs.
# Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
